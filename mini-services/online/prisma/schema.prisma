generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../db/online.db"
}

model OnlineUser {
  id          String   @id @default(cuid())
  nameLower   String   @unique
  name        String
  avatar      String   @default("cat")
  pinHash     String
  pinSalt     String
  token       String   @unique
  coins       Int      @default(300)
  unlockedCsv String   @default("classic,adventure,highstakes")
  wins        Int      @default(0)
  losses      Int      @default(0)
  rankWins    Int      @default(0)
  lastDaily   String   @default("")
  bonusDay    String   @default("")
  bonusToday  Int      @default(0)
  merged      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MatchLog {
  id        String    @id @default(cuid())
  aId       String
  bId       String    @default("")
  stake     Int
  status    String    @default("open")
  winnerId  String?
  createdAt DateTime  @default(now())
  settledAt DateTime?
}
